# ── Sanity (SHARED dataset — must match vanlifeeats's values exactly) ──
# wisewayround and vanlifeeats read/write the SAME Sanity project+dataset by
# design. Set these to the identical values used in vanlifeeats's Vercel
# project env vars. Do NOT point this at a different project ID or dataset.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_WRITE_TOKEN=

# ── Google OAuth (admin sign-in) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── NextAuth ──
# Either name works — auth.config.ts reads AUTH_SECRET first, falling back to NEXTAUTH_SECRET.
AUTH_SECRET=
NEXTAUTH_URL=
# NEXTAUTH_URL must be https://wisewayround.co.uk in Vercel production (not vanlifeeats's domain).

# ── Admin allowlist / header bypass ──
ADMIN_EMAILS=
ADMIN_SECRET=

# ── Mapbox (drive-time/geocoding) ──
MAPBOX_SECRET_TOKEN=
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Anthropic (AI suggestions) ──
ANTHROPIC_API_KEY=

# ── AWS SES (outbound email) ──
# If reusing vanlifeeats's AWS SES credentials/access key, note that AWS SES
# only sends mail FROM a verified sender identity/domain in that account.
# lib/ses.ts and lib/email.ts default the From/Reply-To address to
# hello@wisewayround.co.uk — that address (or the wisewayround.co.uk domain)
# must ALSO be verified in that SES account, or sends will be rejected/bounce,
# even though the access key itself is valid. This is a separate step from
# setting these env vars; do it in the AWS SES console before relying on
# outbound email from this app.
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=

# ── Unsubscribe link signing ──
UNSUBSCRIBE_SECRET=

# ── Canonical site URL (used for OG metadata / metadataBase in app/layout.tsx) ──
# Defaults to https://wisewayround.co.uk in code if unset, which already matches
# production — only set this if a preview/staging deploy needs a different canonical URL.
NEXT_PUBLIC_SITE_URL=
